DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
CORS_ORIGIN=http://localhost:5173
PORT=3001

# Required for AI key encryption (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

# Optional
AI_DAILY_CAP_DEFAULT=200
AI_MONTHLY_TOKEN_CAP_DEFAULT=5000000
COOKIE_CROSS_SITE=false

# Keep-alive ping (prevents Render + Neon from sleeping on free tier)
# Set to your Render service URL, e.g. https://your-app.onrender.com
RENDER_EXTERNAL_URL=